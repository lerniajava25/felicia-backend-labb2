#!/bin/sh
# Runs the test suite before every push. If the tests fail, the push is cancelled.
# Turn it on once per clone: git config core.hooksPath .githooks

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! docker info > /dev/null 2>&1; then
    echo "pre-push: Docker is not running. The tests need it (Testcontainers)."
    echo "pre-push: start Docker and push again."
    exit 1
fi

echo "pre-push: running ./mvnw test ..."
if ! ./mvnw -q test; then
    echo "pre-push: tests failed, push cancelled."
    exit 1
fi

echo "pre-push: all tests passed."
